# ===== Ollama 本地模型配置 =====
OLLAMA_BASE_URL=http://localhost:11435
OLLAMA_MODEL=qwen3.5:122b
OLLAMA_EMBED_MODEL=qwen3-embedding:4b
# ===== 火山方舟 API 配置（Agent 模式使用） =====
MINIMAX_API_KEY=ark-6c047509-3ac1-4689-b796-47363425012c-3112a
# Claude Agent SDK 配置（保留，Agent模式可能使用）
ANTHROPIC_API_KEY=sk-2c2a925037b448a98c6e2e2db1bce574
# Claude Agent SDK git-bash 路径（Windows 必需）
CLAUDE_CODE_GIT_BASH_PATH=D:/software_add/Coding_software/Git/Git/bin/bash.exe
# 代理配置（可选，如主机已配置全局代理则无需设置）
CLAUDE_HTTP_PROXY=http://127.0.0.1:8890
CLAUDE_HTTPS_PROXY=http://127.0.0.1:8890

# ===== MinerU 文档解析配置（可选，opt-in 启用） =====
# 启用 MinerU 本地模型解析路径（true 时优先使用 MinerU，失败回退本地解析器）
USE_MINERU=true
# 本地模型目录路径（MinerU2.5-Pro-2605-1.2B）
MINERU_LOCAL_MODEL_PATH=E:\model\MinerU2.5-Pro-2605-1.2B
# 单文件解析超时秒数（默认 1200）
MINERU_TIMEOUT=1200

# ===== OpenViking 集成配置（Phase 1 capture-only） =====
# OpenViking 服务地址（与 ~/.openviking/ovcli.conf 一致）
OPENVIKING_URL=http://localhost:1933
OPENVIKING_API_KEY=ark-6c047509-3ac1-4689-b796-47363425012c-3112a
OPENVIKING_ACCOUNT=my-team
OPENVIKING_USER=wangzichen
# Agent 在 OpenViking 中的 actor_peer 标识（用于会话归属区分）
OPENVIKING_ACTOR_PEER_ID=design-plan-agent
# 是否启用 OpenViking 集成（false 时静默降级，不影响现有功能）
OPENVIKING_ENABLED=true
